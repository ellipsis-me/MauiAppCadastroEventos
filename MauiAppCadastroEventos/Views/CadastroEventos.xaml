<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppCadastroEventos.Views.CadastroEventos"
             Title="CadastroEventos"
             NavigationPage.HasNavigationBar="False"
            BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout
    VerticalOptions="CenterAndExpand"
    Padding="10">
        <Label 
        Text="Cadastro de eventos"
        FontFamily="Kalam" 
        FontSize="50"
        TextColor="{StaticResource Primary}" />

        <Frame Padding="10"
               BackgroundColor="White">
            <VerticalStackLayout>

                <Frame Padding="10"
                   Margin="10"
                      BackgroundColor="White">

                    <VerticalStackLayout>
                        <Label Text="Nome do evento:" />
                        <Entry x:Name="txt_evento" />
                        
                        <Label Text="Período do evento"/>

                        <HorizontalStackLayout>
                            <Label Text="Data de início"/>
                            <DatePicker x:Name="dtpck_inicio"
                                    Format="dd/MM/yyyy"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <Label Text="Data de término"/>
                            <DatePicker x:Name="dtpck_termino"
                                    Format="dd/MM/yyyy"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <Label Text="Número de participantes:"/>
                            <Label TextColor="{StaticResource Primary}"
                                    Text="{Binding Value}"
                                    BindingContext="{x:Reference stp_participantes}"
                                    Margin="10"/>
                            <Stepper x:Name="stp_participantes"
                                     Minimum="1"
                                     Maximum="1000"
                                     Increment="1"
                                     Margin="10"/>                    
                        </HorizontalStackLayout>
                        <!--<Grid RowDefinitions="Auto, Auto"
                            ColumnDefinitions="4*, *, 2*">
                            <Label Grid.Row="0" Grid.Column="0" Text="Número de participantes:"/>
                            <Label Grid.Row="0" Grid.Column="1"
                               TextColor="{StaticResource Primary}"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_participantes}"/>
                            <Stepper Grid.Row="1" Grid.Column="2"
                                 x:Name="stp_participantes"
                                 Minimum="1"
                                 Maximum="1000"
                                 Increment="1" VerticalOptions="FillAndExpand"/>
                        </Grid>-->

                        <Label Text="Local do evento:" />
                        <Entry x:Name="txt_local" />

                        <Label Text="Custo por participante:" />
                        <Entry x:Name="double_custo_participante" />
                    </VerticalStackLayout>
                </Frame>

                <VerticalStackLayout Spacing="10">
                    <Button Text="Cadastrar" Clicked="Button_Clicked" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>