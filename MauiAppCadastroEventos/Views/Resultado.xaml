<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppCadastroEventos.Views.Resultado"
             Title="Resultado"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout
            VerticalOptions="Center"
            Padding="15"
            Spacing="12">

            <Label 
                Text="Resumo do evento"
                FontFamily="Kalam" 
                FontSize="45"
                HorizontalTextAlignment="Center"
                TextColor="{StaticResource Primary}" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="Nome do evento:" FontAttributes="Bold" />
                <Label TextColor="{StaticResource Primary}"
                       FontAttributes="Bold"
                       Text="{Binding Nome}" />
            </HorizontalStackLayout>

            <Frame BackgroundColor="White" Padding="15" CornerRadius="10">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Data de início:" />
                        <Label Text="{Binding DataInicio, StringFormat='{}{0:dd/MM/yyyy}'}"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Data de Término:" />
                        <Label Text="{Binding DataTermino, StringFormat='{}{0:dd/MM/yyyy}'}"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Duração do Evento:" />
                        <Label Text="{Binding PeriodoEvento, StringFormat='{}{0} dias'}"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White" Padding="15" CornerRadius="10">
                <HorizontalStackLayout Spacing="5">
                    <Label Text="Número de participantes:" />
                    <Label Text="{Binding NumeroParticipantes}"
                           TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
            </Frame>

            <Frame BackgroundColor="White" Padding="15" CornerRadius="10">
                <HorizontalStackLayout Spacing="5">
                    <Label Text="Local do evento:" />
                    <Label Text="{Binding Local}"
                           TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
            </Frame>

            <Frame BackgroundColor="White" Padding="15" CornerRadius="10">
                <HorizontalStackLayout Spacing="5">
                    <Label Text="Custo do Evento:" />
                    <Label Text="{Binding ValorParticipante, StringFormat='{}{0:c}'}"
                           TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
            </Frame>

            <Button Text="Voltar" 
                    Clicked="Button_Clicked" 
                    HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>